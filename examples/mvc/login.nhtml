@model(titre: Text)
<!doctype html><html lang="fr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>@titre — Connexion</title><link rel="stylesheet" href="/static/nolcore.css"></head><body><main class="page"><section class="card"><h1>Connexion</h1><form method="post" action="/v1/auth/login"><label>Email<input type="email" name="email" required></label><label>Mot de passe<input type="password" name="password" required></label><button>Se connecter</button></form><a href="/inscription">Créer un compte</a></section></main></body></html>
