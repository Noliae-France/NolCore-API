import "../nolc/lib/http_client.nol"

fn crawler_robots_autorise(robots: Text, chemin: Text) -> Bool {
    var actif = false
    for ligne0 in split(robots, "\n") {
        let ligne = trim(ligne0)
        if ligne == "" or starts_with(ligne, "#") { continue }
        let deux = find(ligne, ":")
        if not has(deux) { continue }
        let cle = lower(trim(sub(ligne, 0, unwrap_or(deux, 0))))
        let valeur = trim(sub(ligne, unwrap_or(deux, 0) + 1, len(ligne)))
        if cle == "user-agent" { actif = valeur == "*" or lower(valeur) == "nolcorebot"; continue }
        if actif and cle == "disallow" and valeur != "" {
            if starts_with(chemin, valeur) { return false }
        }
    }
    return true
}

fn crawler_robots(url: Text) -> Option<Text> {
    let u = url_parse(url)
    if not has(u) { return none }
    let p = unwrap_or(u, UrlParties { schema: "http", hote: "", port: 80, chemin: "/" })
    let robots = http_get(p.schema + "://" + p.hote + "/robots.txt")
    if not has(robots) { return some("") }
    return some(unwrap_or(robots, ReponseHttp { statut: 0, entetes: "", corps: "" }).corps)
}

fn crawler_get_respectueux(url: Text) -> Option<Text> {
    let u = url_parse(url)
    if not has(u) { return none }
    let robots = crawler_robots(url)
    if not has(robots) or not crawler_robots_autorise(unwrap_or(robots, ""), unwrap_or(u, UrlParties { schema: "http", hote: "", port: 80, chemin: "/" }).chemin) { return none }
    let page = http_get(url)
    if not has(page) { return none }
    return some(unwrap_or(page, ReponseHttp { statut: 0, entetes: "", corps: "" }).corps)
}
